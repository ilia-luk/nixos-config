# nix-direnv bootstrap
if ! has nix_direnv_version || ! nix_direnv_version 2.2.1; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/2.2.1/direnvrc" "sha256-zelF0vLbEl5uaqrfIzbgNzJWGmLzCmYAkInj/LNxvKs="
fi

dotenv_if_exists .env

# reload when these change
watch_file flake.nix
watch_file flake.lock
watch_file .env

# enter your flake devshell (devenv-enabled)
use flake . --impure

# export explicit absolute paths Devenv will read
export DEVENV_ROOT="$PWD"
export DEVENV_DOTFILE="$PWD/.devenv"
export DEVENV_STATE="$PWD/.devenv"
